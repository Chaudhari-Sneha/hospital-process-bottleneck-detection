# Raw datasets are NOT committed.
# The 4TU files are large and come with their own terms of use.
# Anyone cloning this repo should re-download them using src/00_download_data.py
data/raw/
data/interim/

# Synthetic logs are fully reproducible from the seed + the committed manifest,
# so the CSV itself is not committed. The manifest IS - it records the
# assumptions the log was produced under, which is the part that matters.
data/synthetic/*.csv
data/synthetic/**/*.csv

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# Outputs are regenerated by the pipeline
outputs/*.png
outputs/*.svg
outputs/*.html

# Step 22's generated event logs and per-scenario answer keys. Both regenerate
# from the seed in src/22_ground_truth.py, and the answer key is committed
# already in a more useful form: outputs/22_results.csv carries defect_type,
# variant, target_edge and secondary_edge for every scenario, beside what the
# pipeline actually said - one table rather than 27 files.
outputs/22_runs/*_log.csv

# ...but the magnitude sweeps and the re-run each regenerated their own answer
# keys, which is ~160 more files saying nothing the aggregate does not. The
# findings from those live in 22_detection_floor.csv.
outputs/22_runs/22mag*
outputs/22_runs/23_*

# Scratch artifacts from ad-hoc runs and the upload app's own uploads.
outputs/tmp_*
outputs/24_uploads/
outputs/22mag*_s*
outputs/22mag*_c*

# Per-scenario findings and diagnoses from the ground-truth sweep. Regenerated by
# `python src/22_ground_truth.py`; the aggregate 22_report.md, 22_results.csv and
# 22_detection_floor.csv ARE committed, because those are the findings.
outputs/22_s[0-9][0-9]_*
outputs/22_c[0-9]_*

# Secrets - never commit the Claude API key
.env

# NOTHING under data/ is committed.
#
# The event logs are not ours to redistribute (4TU terms), and everything else
# there is a pipeline intermediate that the scripts recreate for themselves -
# both `07_generate_synthetic_log.py` and `09_planted_bottleneck_test.py` call
# mkdir(parents=True, exist_ok=True), and both are seeded, so a regenerated file
# is identical to the one that was deleted. Committing a manifest of parameters
# that already live in config/calibration.yaml just adds a second copy to drift.
#
# `src/00_download_data.py` fetches and md5-verifies the Sepsis log;
# `src/19_holdout_test.py` prints the DOI for the holdout log.
data/

# docs/ holds hand-made assets for the README (screenshots, diagrams). Unlike
# outputs/, nothing here is regenerated, so it IS committed.
!docs/

# Windows folder metadata - never useful in a repo
desktop.ini
Thumbs.db

# Per-run artifacts from the upload app (outputs/24_<timestamp>_*). Each app run
# writes its own findings and diagnosis; they are reproducible and add nothing a
# reader needs. The uploads themselves are ignored above.
outputs/24_[0-9]*

# Large derived artifacts from the holdout log. Regenerated by
# `python src/19_holdout_test.py`; the claims they support are in REPORT.md and
# the numbers are quoted there, so the 1MB of intermediate output adds nothing.
outputs/*Hospital_Billing*

# Per-magnitude sweep reports - 22_detection_floor.csv is their summary.
outputs/22mag*

# ---------------------------------------------------------------------------
# GENERATED OUTPUTS ARE NOT COMMITTED, with three deliberate exceptions.
#
# The rule: a generated file is committed only if reproducing it is EXPENSIVE or
# IMPOSSIBLE. Everything else regenerates in seconds by running the script, so
# committing it just puts a stale copy in the repo waiting to disagree with the
# code.
#
# The exceptions, all listed explicitly below:
#   1. the ground-truth validation results   (a ~25 min sweep + a model)
#   2. one captured rejected run             (nondeterministic - cannot be
#                                             reproduced on demand, and it is
#                                             the evidence the guard fires)
#   3. the evidence package + calibration    (hand-assembled, not derived)
# ---------------------------------------------------------------------------
outputs/*
!outputs/22_report.md
!outputs/22_results.csv
!outputs/22_detection_floor.csv
!outputs/21_holdout_rejected_run.log
!outputs/14_evidence_package.md
!outputs/14_findings.csv
!outputs/14_calibration_status.csv

# src/21 --self-test reads this, and README advertises that command as the guard
# demo that needs no API key and no data. Without it the command fails on a
# fresh clone, telling the reader to run src/20 - which needs the Sepsis log,
# which needs the download. 17 KB removes that chain. Same reason
# outputs/14_findings.csv above is committed for src/15 --self-test.
!outputs/20_findings.json

# Editor config - personal tooling, not project code.
.vscode/

# notes.md is the working record kept for viva preparation: 165 KB of
# debugging narrative, including every wrong turn. It is genuinely useful to
# its author and is not a portfolio artifact, so it stays local. REPORT.md
# carries the findings a reader needs; nothing links to this file.
notes.md

# Editor/tool backups
*.bak
*~

# Working context for the coding assistant. Kept locally because it carries the
# build history and the "do not re-derive" list, but it is not documentation for
# a reader - README.md and REPORT.md cover the project.
CLAUDE.md

# `21_diagnose.py` rewrites this on EVERY rejection, so a committed copy goes
# stale the next time anyone runs the tool - the README once described contents
# that a later test run had already overwritten. The stable evidence is
# outputs/21_holdout_rejected_run.log, a one-off capture that nothing regenerates.
outputs/*_diagnosis_REJECTED.json
